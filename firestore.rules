rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Feedback collection rules
    match /hotline_feedback/{feedbackId} {
      
      // Allow creation for anyone (secured by client logic, authenticated anonymously)
      allow create: if true;
                    
      // Only authenticated users (e.g., your admins) can read, update, or delete feedback
      allow read, update, delete: if request.auth != null;
    }

    // Mail collection rules (for Trigger Email extension)
    match /mail/{mailId} {
      allow create: if true;
                    
      allow read, update, delete: if false; // Securely block reading/updating scheduled mail
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
